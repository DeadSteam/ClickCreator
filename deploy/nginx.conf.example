# Раздача сайта по домену через nginx.
#
# Зачем прокси, а не порт напрямую: Node не должен смотреть в интернет сам.
# За nginx порт 3000 остаётся на localhost, а наружу торчат только 80 и 443.
# Посетитель, который видит в адресной строке ip:3000, не воспринимает
# страницу как сайт компании.
#
# Блоки пяти лендингов-гипотез убраны вместе с папкой sites: проверка
# закончена, дальше идёт один сайт.
#
# Установка:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/topinjector
#   sudo nano /etc/nginx/sites-available/topinjector  # подставить домен
#   sudo ln -s /etc/nginx/sites-available/topinjector /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Сертификаты - certbot, он сам допишет блоки listen 443:
#   sudo certbot --nginx -d topinjector.ru -d www.topinjector.ru

# Общие заголовки прокси. Без X-Forwarded-Proto Next считает, что пришли по
# http, и в редиректах и канонических ссылках появляется http вместо https.
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_http_version 1.1;

server {
    listen 80;
    server_name topinjector.ru www.topinjector.ru;
    location / { proxy_pass http://127.0.0.1:3000; }
}





