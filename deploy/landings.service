# Запуск сайта на Linux-сервере под systemd.
#
# Foreground-скрипт сам по себе для сервера не годится: он умрёт вместе с
# ssh-сессией и не поднимется после перезагрузки. systemd закрывает обе дыры.
#
# Установка:
#   sudo cp deploy/landings.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/landings.service   # поправить User и пути
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now landings
#
# Посмотреть, что происходит:
#   systemctl status landings
#   journalctl -u landings -f
#
# Перезапуск после выкатки новой версии:
#   git pull && npm ci && npm run build:all && sudo systemctl restart landings

[Unit]
Description=TopInjector (порт 3000)
After=network.target

[Service]
Type=simple

# ЗАМЕНИТЬ на пользователя, от которого работает сайт. Не root: процессу
# незачем иметь права на всю машину, чтобы отдавать статику.
User=www-data
Group=www-data

# ЗАМЕНИТЬ на реальный путь к репозиторию на сервере.
WorkingDirectory=/srv/clickcreator

Environment=NODE_ENV=production
# Цвета в журнале systemd превратились бы в escape-мусор. Скрипт и сам их
# гасит, когда вывод не в терминал, но переменная снимает вопрос окончательно.
Environment=NO_COLOR=1

# --host 0.0.0.0 нужен, только если ходить будут прямо в порт. За nginx
# правильнее оставить localhost: тогда 3000 не торчит наружу вовсе.
ExecStart=/usr/bin/node scripts/run-all.mjs --mode start

# Раннер пробрасывает сигнал детям и гасит группу процессов, поэтому
# штатной остановки достаточно. Запас по времени - на закрытие соединений.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=20

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
